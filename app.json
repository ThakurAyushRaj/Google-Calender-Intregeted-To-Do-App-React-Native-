{
  "expo": {
    "name": "Maxpine Flow",
    "slug": "time-lineup",
    "owner": "rajayush",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/appicon.png",
    "scheme": "time-lineup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./src/assets/images/appicon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rajayush.timelineup",
      "permissions": ["SCHEDULE_EXACT_ALARM", "VIBRATE"]
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/appicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/appicon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/appicon.png",
          "color": "#2563EB"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
